# No application secrets are required for loopback-only local development.
# D1 is a Worker binding, not a DATABASE_URL. See wrangler.local.json.
CLOUDFLARE_CF_FETCH_ENABLED=false
WRANGLER_SEND_METRICS=false
# Optional for CLI operations on a separately provisioned Cloudflare account:
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-restricted-token
# Work production credentials are not exported.
